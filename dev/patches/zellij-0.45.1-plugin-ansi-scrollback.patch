+}
+
+/// Retrieves the scrollback contents from the specified pane, styled with the same SGR (ANSI
+/// color/attribute) escape sequences that are used to render the pane on screen.
+///
+/// This is otherwise identical to [`get_pane_scrollback`], but the returned lines are not plain
+/// text: they are interspersed with ANSI escape sequences (e.g. `\x1b[1;32m`) that carry the
+/// pane's colors and text attributes. Callers that need to do column-based arithmetic on the
+/// returned lines (eg. to find the Nth visible character, wrap at a given width, or compare
+/// against plain text) must first strip these escape sequences or otherwise account for them, as
+/// they do not correspond to visible columns.
+///
+/// # Arguments
+/// * `pane_id` - The ID of the pane to get scrollback from
+/// * `get_full_scrollback` - Whether to retrieve the full scrollback buffer (including lines above and below viewport)
+///
+/// # Returns
+/// * `Ok(PaneContents)` - The styled pane contents if successful
+/// * `Err(String)` - An error message if the pane was not found, timed out, or another error occurred
+pub fn get_pane_scrollback_with_ansi(
+    pane_id: PaneId,
+    get_full_scrollback: bool,
+) -> Result<PaneContents, String> {
+    get_pane_scrollback_impl(pane_id, get_full_scrollback, true)
+}
+
+fn get_pane_scrollback_impl(
+    pane_id: PaneId,
+    get_full_scrollback: bool,
+    with_ansi: bool,
+) -> Result<PaneContents, String> {
     let plugin_command = PluginCommand::GetPaneScrollback {
         pane_id,
         get_full_scrollback,
+        with_ansi,
     };
     let protobuf_plugin_command: ProtobufPluginCommand = plugin_command.try_into().unwrap();
     object_to_stdout(&protobuf_plugin_command.encode_to_vec());
