// zclip — example Zellij configuration.
//
// Merge these blocks into ~/.config/zellij/config.kdl. Adjust the plugin path
// to wherever you installed zclip.wasm.

plugins {
    // A plugin alias, so keybindings can say "zclip" instead of repeating the
    // full path. Load zclip in the background at startup so paste works from
    // any pane without you having opened its UI first.
    zclip location="file:~/.config/zellij/plugins/zclip.wasm" {
        // Maximum number of *unnamed* buffers kept. Named buffers are pinned
        // and never count toward this limit, matching tmux's buffer-limit.
        buffer_limit "50"

        // --- Copy-mode key table -------------------------------------------
        //
        // This is a SEPARATE key table from the `keybinds` block below: it is
        // resolved once, at plugin load, from this config block alone. It
        // CANNOT be expressed as ordinary Zellij `keybinds`, for two reasons
        // (see issue #29 for the full argument):
        //
        //   1. Interception (`InterceptInput`) only ever delivers keys that
        //      are UNBOUND in your current Zellij input mode. A key you bind
        //      in `keybinds` is resolved to its bound action before the
        //      intercept layer is ever consulted, so copy mode would simply
        //      never see it -- the opposite of what a key table needs.
        //   2. Zellij's `InputMode` is a fixed, closed enum; there is no
        //      "copy mode" mode a plugin could scope bindings to. Binding a
        //      letter under `normal` would hijack it everywhere, all the
        //      time, not just while copy mode is open.
        //
        // WARNING: because of (1) above, any key you already have bound in
        // `keybinds` (below, or elsewhere in your config) can NEVER reach
        // copy mode, no matter what you write here -- pick key_* overrides
        // that are unbound in your normal input mode. `Ctrl b` is a concrete
        // example: Zellij's own default config binds it to
        // `SwitchToMode "Tmux"`, so the vi preset's `Ctrl b` page-up entry
        // (kept below for completeness) is shadowed and never fires unless
        // you `unbind "Ctrl b"` yourself; `PageUp` is the working default.
        //
        // `keymap` selects a whole preset. "vi" is the default (used when
        // `keymap` is absent); "emacs" is also built in.
        // keymap "vi"

        // `key_<action>` overrides a single action's binding, REPLACING its
        // preset spec entirely rather than adding to it -- so, e.g., setting
        // `key_yank` below stops `y` from yanking; only `Y` would.
        // A value may name more than one key, comma-separated
        // ("y, Enter" binds both keys to the same action). Resolution tries
        // the whole value as ONE key first, and only splits on commas if
        // that fails -- which is what keeps a literal comma bindable
        // (`key_word_forward ","` binds the character `,` itself, it does
        // not fail to parse and fall through to a split).
        //
        // key_yank "Y"
        // key_cancel "Ctrl g, Esc"

        // The full action-name vocabulary, one `key_*` entry per name, valid
        // for either preset:
        //   left, down, up, right,
        //   word_forward, word_backward, word_end,
        //   line_start, line_first_non_blank, line_end,
        //   top, bottom,
        //   half_page_up, half_page_down, page_up, page_down,
        //   select_char, select_line, select_block,
        //   yank, cancel
        //
        // An unknown `keymap` value, an unknown action name after `key_`, or
        // a value that fails to parse as a key (or a comma-separated list of
        // keys) is a configuration mistake, not a fatal one: it produces a
        // warning (shown in zclip's own status line) and the plugin falls
        // back to the preset's existing binding for that action, exactly
        // like an unparseable `buffer_limit` falls back to its default
        // rather than refusing to start.
        //
        // `cancel` is special: if no working binding resolves to it at all
        // (unset, unparseable, or overridden to a key that also fails to
        // parse), `Esc` is reinstated regardless of what this block says.
        // Copy mode holds your keyboard via `InterceptInput` while it is
        // open; a key table with no way to cancel would trap it, not just
        // misconfigure it.
    }
}

load_plugins {
    // Start zclip hidden at session start. This is REQUIRED, not an
    // optimisation: zclip is stateful (it holds the buffer ring), and
    // MessagePlugin (see below) can only reach an already-running plugin
    // instance -- it cannot start one. Without this block none of the
    // bindings below would have anything to talk to.
    zclip
}

keybinds {
    normal {
        // A note on `launch_new`, since it is tempting to reach for here and
        // it is wrong: on MessagePlugin, `launch_new true` does NOT mean
        // "start zclip if it isn't running yet". It stamps a fresh random
        // UUID into the plugin's configuration on every single keypress, and
        // plugin identity is (location, configuration) -- so a new UUID never
        // matches the resident instance and every keypress spawns a brand
        // new, empty zclip. Your buffer ring would evaporate between yank
        // and paste. Never put `launch_new` on a MessagePlugin action for a
        // stateful plugin like zclip; rely on `load_plugins` above instead.

        // Enter copy mode: captures the scrollback of the pane you are in,
        // then zclip swaps its own pane into that exact slot
        // (`replace_pane_with_existing_pane`), so copy mode appears at the
        // target's exact geometry, in the target's own tab -- no floating
        // pane, no relocation needed. Exiting swaps the terminal back into
        // its slot and re-suppresses zclip. That is why this binding is a
        // single plain action rather than the LaunchOrFocusPlugin +
        // MessagePlugin pair used below for `list`: there is no pane to bring
        // into view here, zclip goes to the pane instead of the other way
        // round.
        //
        // NB: tmux's `prefix [` is deliberately NOT reproduced literally.
        // In a terminal, Ctrl+[ *is* the Escape byte (0x1b), so binding it
        // would make Escape unusable. Alt-based bindings avoid that entirely.
        bind "Alt y" { MessagePlugin "zclip" { name "copy_mode"; }; }

        // Leave copy mode. Escape also works from inside copy mode.
        //
        // Copy mode grabs the keyboard (InterceptInput), but that only claims
        // keys that are UNBOUND in your current input mode -- Zellij resolves
        // a bound key to its action before the intercept ever sees it. So
        // your own keybindings, including this one, keep working while copy
        // mode is active: `Alt q` genuinely cancels it. Escape also works
        // from inside copy mode for the same reason -- it is unbound in
        // Normal mode by default, so it reaches the plugin as an intercepted
        // key rather than an action, and copy mode recognises it itself.
        // This binding is simply the always-available, config-driven way out.
        bind "Alt q" { MessagePlugin "zclip" { name "cancel"; }; }

        // Motions inside copy mode are NOT bound here -- these keys are all
        // unbound in Normal mode, so copy mode receives and interprets them
        // directly while it is active:
        //   h j k l / arrows   move by character and line
        //   w b e              word forward / back / end
        //   0 ^ $              line start / first non-blank / line end
        //   g G                top / bottom
        //   Ctrl-u Ctrl-d      half page up / down
        //   Ctrl-b Ctrl-f      page up / down
        //
        //   NOTE: under zellij's DEFAULT keybinds, `Ctrl-b` is bound to
        //   `SwitchToMode "Tmux"`, so that binding is resolved before copy
        //   mode's intercept ever sees the key and page-up-by-Ctrl-b will not
        //   work here. Use `PageUp` instead, or `unbind "Ctrl b"` in your
        //   config if you want the vi key back.
        //
        //   v                  start/cancel char-wise selection
        //   V                  line-wise selection (whole lines)
        //   Ctrl-v             block selection (a rectangle -- use this for
        //                      columnar output like `ls -l` or tables)
        //   y                  yank the selection and leave copy mode
        //   Esc                cancel the selection, or leave copy mode if
        //                      there is no selection
        //
        // Also note: ALL of your `Alt` bindings remain live during copy mode
        // too (as do zellij's own defaults, e.g. `Alt n` = NewPane, `Alt
        // h/j/k/l` = MoveFocus) -- those keys are bound, so they do their
        // normal thing rather than being swallowed by copy mode.

        // Paste the most recent buffer into the pane you are currently in.
        // This is the tmux `prefix ]` equivalent. It works from any pane
        // because MessagePlugin reaches zclip even while it is unfocused or
        // hidden -- you do not have to focus the plugin to paste.
        //
        // Deliberately a single, plain MessagePlugin action with no
        // LaunchOrFocusPlugin alongside it: paste must NOT steal focus or
        // move zclip's pane into your tab, since the whole point is to write
        // into the pane you are already in.
        bind "Alt p" { MessagePlugin "zclip" { name "paste"; }; }

        // Paste a specific buffer, by name or by index (0 = most recent).
        // `payload` is the selector; a name always wins over an index.
        bind "Alt P" { MessagePlugin "zclip" { name "paste"; payload "1"; }; }

        // Show the buffer browser. Unlike copy mode, the list view has no
        // single pane to swap into -- it is genuinely a floating UI -- so
        // this binding still fires two actions: LaunchOrFocusPlugin's
        // `move_to_focused_tab` first relocates zclip's pane into whichever
        // tab you are currently in (the resident instance's pane otherwise
        // stays wherever it started), then MessagePlugin tells that same
        // instance to open the list view. Plain MessagePlugin has no
        // `move_to_focused_tab` equivalent, which is why this needs both
        // actions rather than one.
        //
        // IMPORTANT: use the `zclip` ALIAS here, exactly as `load_plugins`
        // above does. Do not substitute the full `file:` URL. Zellij matches
        // a keybind's plugin against a running pane with
        // `RunPluginOrAlias::is_equivalent_to_run` (zellij-utils
        // src/input/layout.rs:191), which has arms for (Alias, Alias),
        // (Alias, RunPlugin) and (RunPlugin, RunPlugin) -- but NOT for
        // (RunPlugin, Alias), which falls through to `_ => false`. Naming the
        // plugin by URL here while `load_plugins` names it by alias is that
        // unhandled combination: LaunchOrFocusPlugin never finds the resident
        // instance and spawns a new one on every keypress. Confusingly, the
        // paste binding would keep working, because MessagePlugin routes on
        // the RESOLVED (location, configuration) pair and is blind to the
        // alias/URL distinction -- so the breakage looks like it is specific
        // to whichever binding uses LaunchOrFocusPlugin.
        bind "Alt b" {
            LaunchOrFocusPlugin "zclip" { floating true; move_to_focused_tab true; };
            MessagePlugin "zclip" { name "list"; };
        }
    }
}
